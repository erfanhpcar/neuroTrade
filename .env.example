# neuroTrade local/dev example. Copy to `.env` and never commit real secrets.
# Default trading mode is PAPER. Do not set FULL until Phase 10 live readiness.

APP_ENV=development
TRADING_MODE=PAPER
LOG_LEVEL=INFO

# Native (Makefile) hosts. Compose overrides these to postgres/redis service names.
# Alembic reads DATABASE_URL. Fake local password only; never commit real secrets.
DATABASE_URL=postgresql+asyncpg://neurotrade:neurotrade_dev_password@localhost:5432/neurotrade
REDIS_URL=redis://localhost:6379/0

# Next.js server-side rewrite target. Copy frontend/.env.example if running the dashboard.
# Do not put this in NEXT_PUBLIC_*.
BACKEND_URL=http://127.0.0.1:8000

MARKET_DATA_PROVIDER=bybit
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=4h

# Private exchange credentials are unused in Phase 0. Leave empty.
# Withdrawal must remain disabled. Transfer remains disabled.
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
