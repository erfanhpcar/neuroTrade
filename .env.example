# neuroTrade example environment. Copy to `.env` for local development.
# Never commit a real `.env` or any real secret. Example values are fake.

APP_ENV=development

# Safe default. Never set FULL casually; live execution requires explicit,
# persisted promotion + deployment policy (see docs/14_DOCKER_DEPLOYMENT.md).
TRADING_MODE=PAPER

# Inside docker-compose the hosts are the service names (postgres/redis).
# For running natively on the host, use localhost (see .cursor/environment.json).
DATABASE_URL=postgresql+asyncpg://neurotrade:neurotrade@postgres:5432/neurotrade
REDIS_URL=redis://redis:6379/0

MARKET_DATA_PROVIDER=bybit
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=4h

# Dashboard origin allowed by backend CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Backend base URL used by the Next.js dashboard.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Private exchange execution — leave blank until an approved private-execution
# phase. Credentials belong in secret storage, never in this file.
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
